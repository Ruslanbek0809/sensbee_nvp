# Example .env file for the project.
# Copy this file to .env and fill in the values. Do not commit this file to git.

# LLM Provider (groq, openai, mistral, or local)
LLM_PROVIDER=groq

# API Keys - get from respective provider dashboards
MISTRAL_API_KEY=your-mistral-api-key
GROQ_API_KEY=your-groq-api-key
OPENAI_API_KEY=your-openai-api-key

# Local model (for provider=local, requires GPU)
LOCAL_MODEL=llama2-7b

# SensBee sensor credentials (optional - for API access)
# Get from SensBee dashboard: https://sensbee.smartcity.ilmenau.de
MANEBACH_WEATHER_STATION_SENSOR_UUID=your-sensor-uuid
MANEBACH_WEATHER_STATION_MY_API_KEY_READ=your-read-api-key

# HuggingFace token (for gated models like Llama-2)
HF_TOKEN=your-huggingface-token
