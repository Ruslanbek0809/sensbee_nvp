# Example .env file for the project.
# Copy this file to .env and fill in the values. Do not commit this file to git.

# LLM Provider (groq, openai, mistral, or local)
LLM_PROVIDER=groq

# API Keys - get from respective provider dashboards
MISTRAL_API_KEY=your-mistral-api-key
GROQ_API_KEY=your-groq-api-key
OPENAI_API_KEY=your-openai-api-key

# Local model (for provider=local, requires GPU)
LOCAL_MODEL=llama2-7b

# SensBee sensor credentials (optional - for API access)
# Get from SensBee dashboard: https://sensbee.smartcity.ilmenau.de
MANEBACH_WEATHER_STATION_SENSOR_UUID=your-sensor-uuid
MANEBACH_WEATHER_STATION_MY_API_KEY_READ=your-read-api-key

# More sensors for provider=chronos-2 (optional). A configured sensor gets the setup chosen in the benchmark:
# - weather stations: the other configured stations' temperature as extra input, but only when the request carries
#   the station's own READ key below (other callers get plain Chronos-2);
# - halls (visitors_total): forecasts set to 0 in slots where the hall was rarely open over the last 28 days.
# Unconfigured sensors get plain Chronos-2.
STUTZERBACH_WEATHER_STATION_SENSOR_UUID=your-sensor-uuid
STUTZERBACH_WEATHER_STATION_MY_API_KEY_READ=your-read-api-key
FRAUENWALD_WEATHER_STATION_SENSOR_UUID=your-sensor-uuid
FRAUENWALD_WEATHER_STATION_MY_API_KEY_READ=your-read-api-key
EISHALLE_SENSOR_UUID=your-sensor-uuid
EISHALLE_MY_API_KEY_READ=your-read-api-key
SCHWIMMHALLE_SENSOR_UUID=your-sensor-uuid
SCHWIMMHALLE_MY_API_KEY_READ=your-read-api-key

# HuggingFace token (for gated models like Llama-2)
HF_TOKEN=your-huggingface-token
